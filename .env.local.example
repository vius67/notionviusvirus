NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only — Supabase project settings > API > service_role key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Server-only — any random string, shared with the GitHub Actions secret CRON_SECRET.
CRON_SECRET=generate_a_random_string
